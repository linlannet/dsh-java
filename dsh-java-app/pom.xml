<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.linlan.dsh</groupId>
        <artifactId>dsh-java</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dsh-java-app</artifactId>
    <name>dsh-java-app</name>
    <description>
        DSH-JAVA 应用装配层：Spring Boot 启动入口、模块编排与配置加载。
    </description>
    <url>https://github.com/linlannet/dsh-java</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/linlannet/dsh-java/tree/main/dsh-java-app</url>
        <connection>scm:git:git://github.com/linlannet/dsh-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/linlannet/dsh-java.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>linlan</id>
            <name>linlan info</name>
            <email>linlannet@163.com</email>
            <organization>Linlan Corporation</organization>
            <url>https://github.com/linlannet</url>
            <roles>
                <role>Member</role>
            </roles>
            <timezone>Asia/Beijing</timezone>
        </developer>
    </developers>

    <dependencies>
        <dependency>
            <groupId>net.linlan.dsh</groupId>
            <artifactId>dsh-java-trigger</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.linlan.dsh</groupId>
            <artifactId>dsh-java-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 引入示例插件 JAR，构建时复制到 install-root 供 preset 预装使用 -->
        <dependency>
            <groupId>net.linlan.dsh</groupId>
            <artifactId>sample-tools-plugin</artifactId>
            <version>0.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 构建时把插件 JAR 复制到 ./plugins/ 目录，preset 配置的 source-path 直接引用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>net.linlan.dsh</groupId>
                                    <artifactId>sample-tools-plugin</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <destFileName>sample-tools-plugin-1.0.0.jar</destFileName>
                                    <outputDirectory>${project.basedir}/../plugins</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
