  <diagram id="lifecycle" name="03-插件开发与安装">
    <mxGraphModel dx="1473" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lc-title" value="从写插件到被 Agent 使用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102A43;" parent="1" vertex="1">
          <mxGeometry x="50" y="28" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lc-subtitle" value="开发阶段产出一个 JAR；运行阶段由 Harness 加载 JAR，并把工具注册给 Agent。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#52606D;" parent="1" vertex="1">
          <mxGeometry x="52" y="80" width="1800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="lc-dev" value="① 开发者 / 你的工程" style="swimlane;html=1;rounded=1;startSize=42;collapsible=0;fontSize=17;fontStyle=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#4A78A8;fontColor=#173F5F;" parent="1" vertex="1">
          <mxGeometry x="50" y="190" width="500" height="610" as="geometry" />
        </mxCell>
        <mxCell id="lc-pom" value="pom.xml&#xa;依赖 dsh-java-types" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#9FBAD0;" parent="lc-dev" vertex="1">
          <mxGeometry x="30" y="75" width="440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-code" value="MyPlugin + MyTool&#xa;实现业务能力" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#9FBAD0;" parent="lc-dev" vertex="1">
          <mxGeometry x="30" y="185" width="440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-meta" value="META-INF/plugin.yaml&#xa;+ ServiceLoader 文件" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#9FBAD0;" parent="lc-dev" vertex="1">
          <mxGeometry x="30" y="295" width="440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-build" value="mvn clean package&#xa;产出 my-plugin.jar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#9FBAD0;" parent="lc-dev" vertex="1">
          <mxGeometry x="30" y="405" width="440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-harness" value="② dsh-java" style="swimlane;html=1;rounded=1;startSize=42;collapsible=0;fontSize=17;fontStyle=1;whiteSpace=wrap;fillColor=#FFF4E5;strokeColor=#D99000;fontColor=#704B00;" parent="1" vertex="1">
          <mxGeometry x="700" y="190" width="600" height="610" as="geometry" />
        </mxCell>
        <mxCell id="lc-install" value="POST /api/harness/plugins/install&#xa;读取 plugin.yaml，复制 / 加载 JAR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#E1B65C;" parent="lc-harness" vertex="1">
          <mxGeometry x="35" y="75" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lc-loader" value="Plugin Runtime&#xa;ClassLoader 隔离加载入口类" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#E1B65C;" parent="lc-harness" vertex="1">
          <mxGeometry x="35" y="190" width="530" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-register" value="注册工具、提示词、Hook&#xa;生成 plugin__插件ID__工具名" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#E1B65C;" parent="lc-harness" vertex="1">
          <mxGeometry x="35" y="300" width="530" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-active" value="activate / run&#xa;插件进入 ACTIVE，可被 Agent 调用" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#E1B65C;" parent="lc-harness" vertex="1">
          <mxGeometry x="35" y="410" width="530" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-runtime" value="③ 运行时" style="swimlane;html=1;rounded=1;startSize=42;collapsible=0;fontSize=17;fontStyle=1;whiteSpace=wrap;fillColor=#F1EAFE;strokeColor=#8B5CF6;fontColor=#4C1D95;" parent="1" vertex="1">
          <mxGeometry x="1450" y="190" width="620" height="610" as="geometry" />
        </mxCell>
        <mxCell id="lc-question" value="用户提问&#xa;你的应用调用 /api/agent/stream" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#B7A0F4;" parent="lc-runtime" vertex="1">
          <mxGeometry x="35" y="75" width="550" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-call" value="模型选择工具&#xa;Harness 执行插件 Tool" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#B7A0F4;" parent="lc-runtime" vertex="1">
          <mxGeometry x="35" y="190" width="550" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-business" value="插件通过 HTTP / SDK / JDBC&#xa;拿到你的业务数据并返回结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#B7A0F4;" parent="lc-runtime" vertex="1">
          <mxGeometry x="35" y="300" width="550" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-answer" value="Harness 继续生成答案&#xa;SSE 返回你的应用页面" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#B7A0F4;" parent="lc-runtime" vertex="1">
          <mxGeometry x="35" y="410" width="550" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lc-e1" value="提交 JAR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4A78A8;endArrow=block;" parent="1" source="lc-build" target="lc-install" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="633" />
              <mxPoint x="620" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lc-e2" value="加载" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D99000;endArrow=block;" parent="1" source="lc-install" target="lc-loader" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-e3" value="注册" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D99000;endArrow=block;" parent="1" source="lc-loader" target="lc-register" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-e4" value="启动" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D99000;endArrow=block;" parent="1" source="lc-register" target="lc-active" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-e5" value="开发完成后，Agent 进入运行链路" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8B5CF6;endArrow=block;" parent="1" source="lc-active" target="lc-question" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1360" y="638" />
              <mxPoint x="1360" y="303" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lc-e6" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8B5CF6;endArrow=block;" parent="1" source="lc-question" target="lc-call" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-e7" value="业务 API / 数据库" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8B5CF6;endArrow=block;" parent="1" source="lc-call" target="lc-business" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-e8" value="ToolExecutionResult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;strokeColor=#8B5CF6;endArrow=block;" parent="1" source="lc-business" target="lc-answer" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-tip" value="小白记忆法：插件不是数据库本身，插件是一个“会说 Agent 语言的业务适配器”。它接收工具参数，调用你的业务接口，再把真实结果交还给 Harness。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#FFF4CC;strokeColor=#D6B656;fontColor=#6B4E00;" parent="1" vertex="1">
          <mxGeometry x="300" y="900" width="1500" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
