      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ov-title" value="DSH Java 插件如何连接你的应用 " style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102A43;" parent="1" vertex="1">
          <mxGeometry x="50" y="70" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ov-subtitle" value="一句话理解：你的应用负责发起对话，Harness 负责思考和编排，插件负责调用你的业务 API，业务数据仍然在你的系统里。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#52606D;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="1900" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ov-note" value="关键边界：dsh-java 不会自动读取你的数据库；插件才是连接 Agent 与业务系统的桥。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fillColor=#FFF4CC;strokeColor=#D6B656;fontColor=#6B4E00;" parent="1" vertex="1">
          <mxGeometry x="920" y="230" width="560" height="55" as="geometry" />
        </mxCell>
